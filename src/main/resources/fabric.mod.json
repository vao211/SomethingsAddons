{
  "schemaVersion": 1,
  "id": "somethingsaddons",
  "version": "${version}",
  "name": "SomethingsAddons",
  "description": "A fabric mod that adds some configs to your game",
  "authors": ["vao211"],
  "contact": {
    "modrinth": "https://modrinth.com/mod/somethingsaddons",
    "curseforge": "https://www.curseforge.com/minecraft/mc-mods/somethingsaddons",
    "sources": "https://github.com/vao211/SomethingsAddons.git",
    "issues": "https://github.com/vao211/SomethingsAddons/issues"
  },
  "license": "CC-BY-NC-4.0",
  "icon": "assets/somethingsaddons/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "vao211.somethingsaddons.client.SomethingsaddonsDataGenerator"
    ],
    "client": [
      "vao211.somethingsaddons.client.SomethingsaddonsClient"
    ],
    "main": [
      "vao211.somethingsaddons.Somethingsaddons"
    ]
  },
  "mixins": [
    "somethingsaddons.mixins.json",
    {
      "config": "somethingsaddons.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
